OLLAMA_API_URL=http://localhost:11434/api

# Auth.js
AUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional dedicated secret for encrypting stored per-user LLM credentials.
# Use a different value from AUTH_SECRET in production so keys can rotate independently.
LLM_SETTINGS_ENCRYPTION_KEY=

# Optional agent-token support. Token issuance is disabled when the secret is empty.
AGENT_TOKEN_SECRET=
AUTH_ENABLE_AGENT_TOKEN_LOGIN=0

# Read-only local Nodes CLI actor context. Prefer NODES_AGENT_TOKEN for agents
# and shared environments; direct user ids are for trusted local processes.
NODES_AGENT_TOKEN=
NODES_CLI_USER_ID=
NODES_CLI_USER_EMAIL=

# Optional local Codex agent runtime.
# Run services/codex-runner on a machine with Codex CLI installed and authenticated.
CODEX_RUNNER_URL=http://127.0.0.1:8787
# Shared secret between Nodes and the local Codex runner.
CODEX_RUNNER_TOKEN=

# Optional local NOOA runtime. Run services/nooa-runner on a machine with an
# OpenShell gateway, a reviewed policy, and a NOOA-enabled sandbox image.
NOOA_RUNNER_URL=http://127.0.0.1:8788
# Shared secret between Nodes and the local NOOA runner.
NOOA_RUNNER_TOKEN=

# Optional explicit callback endpoint for trusted runners to push runtime events.
# When empty, Nodes derives /api/agents/runtime-events from NEXTAUTH_URL or VERCEL_URL.
NODES_RUNTIME_EVENT_SINK_URL=

# Local development fallback auth
AUTH_ENABLE_DEV_CREDENTIALS=1
AUTH_DEV_EMAIL=demo@nodes.local
# Do not use a known default password. Required when dev credentials are enabled.
AUTH_DEV_PASSWORD=replace-with-a-random-password
AUTH_DEV_NAME=Local Developer

# E2E authentication override. Keep disabled outside isolated automated tests.
ALLOW_E2E_AUTH_OVERRIDE=0

# Advanced local-only route. Disabled by default in the cloud-first app flow.
# ENABLE_OLLAMA_CONTROL_ROUTE=1

# chat persistence -- sign up on cloud.assistant-ui.com
# NEXT_PUBLIC_ASSISTANT_BASE_URL=

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-key
# Optional: Management key used only for automated OpenRouter key rotation
OPENROUTER_MANAGEMENT_API_KEY=
# Optional: spending limit in USD for newly rotated OpenRouter runtime keys.
# Defaults to 0.01 (one cent).
OPENROUTER_ROTATION_LIMIT_USD=0.01
# Optional: hash of the current OpenRouter runtime key to allow automatic revocation
OPENROUTER_API_KEY_HASH=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
# Public-safe default:
# - By default, deployments do NOT use a shared OpenRouter key for end users.
# - Users add their own key in Profile > LLM Models and it is stored server-side.
# Set to 1 to allow using the deployment OpenRouter key as a fallback.
OPENROUTER_ALLOW_DEPLOYMENT_KEY=0
# Set to 1 to force per-user OpenRouter API keys (deployment key will be ignored even if allowed).
OPENROUTER_REQUIRE_USER_KEY=1
# Optional metadata for OpenRouter rate limiting / attribution
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=Nodes

# User plan defaults and quota shaping
# New accounts fall back to this plan when no explicit record exists yet.
NODES_DEFAULT_USER_PLAN=free
# Free plan defaults: 8/min, 40/hour, 120/day, 1 concurrent run
# NODES_PLAN_FREE_CHAT_LIMIT_PER_MINUTE=8
# NODES_PLAN_FREE_CHAT_LIMIT_PER_HOUR=40
# NODES_PLAN_FREE_CHAT_LIMIT_PER_DAY=120
# NODES_PLAN_FREE_CHAT_LIMIT_CONCURRENT=1
# Paid plan defaults: 24/min, 120/hour, 600/day, 2 concurrent runs
# NODES_PLAN_PAID_CHAT_LIMIT_PER_MINUTE=24
# NODES_PLAN_PAID_CHAT_LIMIT_PER_HOUR=120
# NODES_PLAN_PAID_CHAT_LIMIT_PER_DAY=600
# NODES_PLAN_PAID_CHAT_LIMIT_CONCURRENT=2
# Distributed chat-run leases expire automatically if a server instance terminates unexpectedly.
# The value is clamped between 30 and 600 seconds; the default is 120.
# NODES_CHAT_LEASE_TTL_SECONDS=120

# Artifact upload admission limits. Uncomment to override the server defaults.
# NODES_UPLOAD_REQUESTS_PER_MINUTE=12
# NODES_UPLOAD_BYTES_PER_MINUTE=50331648
# NODES_UPLOAD_REQUESTS_PER_HOUR=120
# NODES_UPLOAD_BYTES_PER_HOUR=536870912

# Structured LLM audit logs. Set to 0 to disable emission.
NODES_LLM_OBSERVABILITY=1

# Optional internal admin allowlist for the built-in admin users screen.
# Comma-separated emails and/or user IDs.
# NODES_ADMIN_EMAILS=admin@example.com
# NODES_ADMIN_USER_IDS=

# Support ticket notifications
# Comma-separated emails that receive ticket notifications.
SUPPORT_ADMIN_EMAILS=support@example.com
# Optional explicit sender address for support notifications.
# SUPPORT_EMAIL_FROM=support@example.com

# Project notifications (member added + collaborator access)
# Uses SUPPORT_ADMIN_EMAILS recipients and the configured SMTP settings.
# Optional: notification dedupe state path for project access alerts.
# PROJECT_NOTIFICATION_STORE_DIR=./data/project-notifications
# Free-tier support guardrails (enforced in app):
# - max 5 tickets per account
# - no attachments
# - text-only payload limits for ticket title/body/comments

# Persistence backend
NODES_PERSISTENCE_BACKEND=file
# Set to 1 only for trusted remote deployments once cloud persistence is enabled.
ALLOW_REMOTE_API=0

# Security: allow remote Ollama base URLs (disabled by default).
# If enabled, consider setting an allowlist via OLLAMA_ALLOWED_HOSTNAMES.
ALLOW_OLLAMA_REMOTE_HOSTS=0
# Optional allowlist of Ollama hostnames when ALLOW_OLLAMA_REMOTE_HOSTS=1.
# Comma-separated hostnames (no scheme).
# OLLAMA_ALLOWED_HOSTNAMES=ollama.internal.example.com

# Supabase cloud persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SESSION_ARTIFACTS_BUCKET=session-artifacts
# Required only for importing old local data that has no ownerId yet
SUPABASE_MIGRATION_OWNER_ID=
# Local-only helper for CLI linking / migration workflows
SUPABASE_DB_URL=
# Requires a Supabase personal access token with API key read/write permissions
SUPABASE_ACCESS_TOKEN=

# Cloud-first defaults used by the app when no local overrides are set
DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
NEXT_PUBLIC_DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
NEXT_PUBLIC_DEFAULT_PROVIDER=openrouter
# Optional local-first example instead:
# DEFAULT_MODEL=gemma3:4b
# NEXT_PUBLIC_DEFAULT_MODEL=gemma3:4b
# NEXT_PUBLIC_DEFAULT_PROVIDER=ollama
