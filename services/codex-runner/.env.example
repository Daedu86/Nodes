# Bind locally by default. Use a private network/tunnel when Nodes runs remotely.
CODEX_RUNNER_HOST=127.0.0.1
CODEX_RUNNER_PORT=8787

# Tycho evolution worker. server-launcher.mjs starts this second listener in the
# same trusted process; default port is CODEX_RUNNER_PORT + 1.
TYCHO_EVOLUTION_RUNNER_PORT=8788
TYCHO_EVOLUTION_MAX_CONCURRENCY=4
TYCHO_EVOLUTION_HARD_TIMEOUT_MS=1200000
# TYCHO_EVOLUTION_TEMP_ROOT=/absolute/path/to/runner-managed/temp

# M2 execution backend. `local` preserves the Docker/Finch runner from M1.
# `kubernetes` keeps the same durable episode API but submits one Kubernetes Job
# per candidate. The Evolution Loop and Codex generator do not change.
TYCHO_EVOLUTION_EXECUTION_BACKEND=local

# M3 strategy learning controller. `off` preserves exact M1/M2 generation behavior.
# `observe` records policy-conditioned trajectories without updating Q-values.
# `online` enables deterministic epsilon-greedy strategy selection plus
# persistent Q-learning after evaluated generations.
TYCHO_LEARNING_MODE=off
# TYCHO_LEARNING_STATE_DIR=/absolute/path/to/runner-managed/learning-state
TYCHO_LEARNING_ALPHA=0.25
TYCHO_LEARNING_GAMMA=0.85
TYCHO_LEARNING_EPSILON=0.15

# M4 hierarchical multi-agent controller. `off` preserves exact M3 single-agent
# generation. `observe` enables topology selection without learning; `online`
# learns which team topology works best for each M3 state+strategy context.
# Available topologies: single, parallel-specialists, proposer-critic, debate.
TYCHO_MULTI_AGENT_MODE=off
TYCHO_MULTI_AGENT_ALPHA=0.25
TYCHO_MULTI_AGENT_EPSILON=0.12

# Kubernetes backend settings. Required only when the execution backend is
# `kubernetes`. Each logical workspace id maps to a pre-provisioned read-only
# source PVC; the Job copies it into a per-candidate emptyDir before execution.
# KUBECTL_BIN=kubectl
# TYCHO_KUBERNETES_CONTEXT=kind-nodes
# TYCHO_KUBERNETES_NAMESPACE=nodes-evolution
# TYCHO_KUBERNETES_IMAGE=tycho-kubernetes:0.1
# TYCHO_KUBERNETES_IMAGE_PULL_POLICY=IfNotPresent
# TYCHO_KUBERNETES_RUNNER_ID=nodes-local
# TYCHO_KUBERNETES_TTL_SECONDS=3600
# TYCHO_KUBERNETES_WORKSPACES_JSON={"project-id":{"persistentVolumeClaim":"nodes-workspace","subPath":"project"}}

# Shared secret used by the Nodes server when calling both runner listeners.
# It stays on the trusted runner and is never injected into candidate Pods.
CODEX_RUNNER_TOKEN=replace-with-a-long-random-secret

# Codex executable. The machine must already be authenticated with `codex login`.
CODEX_BIN=codex

# Default model for Canvas Codex agent runs. Keep Luna as the default execution model.
CODEX_RUNNER_MODEL=gpt-5.6-luna

# Tycho experiment CLI. Local execution requires `tycho-experiment --doctor` to
# pass with Docker or Finch. Kubernetes Jobs use the Tycho image configured
# above and set TYCHO_SANDBOX_RUNTIME=kubernetes inside the isolated Pod.
TYCHO_EXPERIMENT_BIN=tycho-experiment
TYCHO_DOCTOR_TIMEOUT_MS=20000

# Choose one workspace strategy for Codex/local runner work:
# 1) One default repository/workspace for ordinary Codex runs.
CODEX_DEFAULT_CWD=/absolute/path/to/your/repository
# 2) Map Nodes project/workspace ids to runner-owned absolute paths. Local
# evolution requires this map; Kubernetes evolution uses TYCHO_KUBERNETES_WORKSPACES_JSON.
# CODEX_WORKSPACES_JSON={"project-id":"/absolute/path/to/repository"}

# Keep global host auto-approval disabled. A workload with an authoritative
# .nodes/tycho-experiment.json is started in the narrower Tycho-isolated mode:
# Codex uses approvalPolicy=never with workspaceWrite sandboxing, and unexpected
# approval/escalation requests are declined instead of prompting the user.
CODEX_RUNNER_AUTO_APPROVE=0
CODEX_RUNNER_REQUEST_TIMEOUT_MS=30000
CODEX_RUNNER_APPROVAL_TIMEOUT_MS=300000
