# Bind locally. Keep this runner off the public internet.
NOOA_RUNNER_HOST=127.0.0.1
NOOA_RUNNER_PORT=8788
NOOA_RUNNER_TOKEN=replace-with-a-long-random-secret

# Local OpenShell CLI and a model identifier understood by NOOA/LiteLLM.
OPENSHELL_BIN=openshell
NOOA_MODEL=gpt-5-mini
NOOA_MAX_ITERATIONS=12
NOOA_MAX_CONCURRENT_RUNS=2
NOOA_OPENSHELL_TIMEOUT_MS=900000

# The sandbox image must contain Python and the `nooa` package. Build the
# supplied Dockerfile once, then use its local image name here.
NOOA_SANDBOX_IMAGE=nodes-nooa:local

# Optional default workspace, or map Canvas project/workspace ids to trusted
# host directories. The runner never accepts a raw path from an HTTP request.
# NOOA_DEFAULT_CWD=/absolute/path/to/repository
# NOOA_WORKSPACES_JSON={"project-id":"/absolute/path/to/repository"}

# Every selectable policy is server-owned. A policy can optionally declare
# OpenShell provider names that have already been configured on the gateway.
NOOA_OPENSHELL_POLICIES_JSON={"code-safe":{"path":"/absolute/path/to/nooa-policy.yaml","providers":["openai"]}}
